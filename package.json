{
  "name": "kcs-teacher-evaluation-demo",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:cloudflare": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "deploy:cloudflare": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext-cloudflare deploy",
    "deploy:production": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext-cloudflare deploy --env production",
    "types:cloudflare": "wrangler types",
    "types:production": "wrangler types --env production",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply kcs_teacher_evaluation_demo_db --local",
    "db:migrate:cloudflare": "wrangler d1 migrations apply kcs_teacher_evaluation_demo_db --remote",
    "db:migrate:production": "wrangler d1 migrations apply kcs_teacher_evaluation_demo_db --remote --env production"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vinext/cloudflare": "1.0.0-beta.2",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
