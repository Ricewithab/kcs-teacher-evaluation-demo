{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kcs-teacher-evaluation-demo",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "brycep.com/apps/teacher-evaluation*",
      "zone_name": "brycep.com"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 }
  }
  // D1 will be bound after `wrangler d1 create kcs-teacher-evaluation-demo-db`.
}
